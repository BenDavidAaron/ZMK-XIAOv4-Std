#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        QwertyBase {
            bindings = <
&kp LEFT_COMMAND  &kp N1  &kp N2  &kp N3      &kp N4     &kp N5     &kp N6     &kp N7         &kp N8      &kp N9   &kp N0    &kp RIGHT_COMMAND
&kp LEFT_ALT      &kp Q   &kp W   &kp E       &kp R      &kp T      &kp Y      &kp U          &kp I       &kp O    &kp P     &kp RIGHT_ALT
&kp LCTRL         &kp A   &kp S   &kp D       &kp F      &kp G      &kp H      &kp J          &kp K       &kp L    &kp SEMI  &kp RCTRL
&kp LEFT_SHIFT    &kp Z   &kp X   &kp C       &kp V      &kp B      &kp N      &kp M          &kp COMMA   &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                                  &kp ESCAPE  &kp SPACE  &kp TAB    &kp ENTER  &kp BACKSPACE  &kp DELETE
                                  &mo 1       &mo 2      &mo 3      &mo 4      &mo 5          &mo 6
            >;
        };

        Media {
            bindings = <
&trans  &none  &none  &none   &none   &none     &none         &none              &none            &none               &none  &trans
&trans  &none  &none  &none   &none   &none     &none         &none              &none            &none               &none  &trans
&trans  &none  &none  &none   &none   &none     &kp C_REWIND  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_FAST_FORWARD  &none  &trans
&trans  &none  &none  &none   &none   &none     &none         &none              &none            &none               &none  &trans
                      &trans  &trans  &trans    &kp C_STOP    &kp C_PLAY_PAUSE   &kp C_MUTE
                      &trans  &none   &none     &none         &none              &none
            >;
        };

        Navigation {
            bindings = <
&trans  &none  &none  &none   &none   &none     &none     &none        &none          &none      &none     &trans
&trans  &none  &none  &none   &none   &none     &kp HOME  &kp PAGE_UP  &kp PAGE_DOWN  &kp END    &none     &trans
&trans  &none  &none  &none   &none   &none     &kp LEFT  &kp DOWN     &kp UP         &kp RIGHT  &kp CAPS  &trans
&trans  &none  &none  &none   &none   &none     &none     &none        &none          &none      &none     &trans
                      &trans  &trans  &trans    &trans    &trans       &trans
                      &none   &trans  &none     &none     &none        &none
            >;
        };

        Mouse {
            bindings = <
&trans  &none  &none  &none   &none   &none     &none           &none           &none         &none            &none  &trans
&trans  &none  &none  &none   &none   &none     &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none  &trans
&trans  &none  &none  &none   &none   &none     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none  &trans
&trans  &none  &none  &none   &none   &none     &none           &none           &none         &none            &none  &trans
                      &trans  &trans  &trans    &mkp RCLK       &mkp LCLK       &mkp MCLK
                      &none   &none   &trans    &none           &none           &none
            >;
        };

        Symbols {
            bindings = <
&trans  &none           &none            &none                 &none                  &none              &none   &none   &none   &none  &none  &trans
&trans  &kp LEFT_BRACE  &kp AMPERSAND    &kp STAR              &kp LPAR               &kp RIGHT_BRACE    &none   &none   &none   &none  &none  &trans
&trans  &kp COLON       &kp DOLLAR       &kp PERCENT           &kp CARET              &kp PLUS           &none   &none   &none   &none  &none  &trans
&trans  &kp TILDE       &kp EXCLAMATION  &kp AT                &kp HASH               &kp PIPE           &none   &none   &none   &none  &none  &trans
                                         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE     &trans  &trans  &trans
                                         &none                 &none                  &none              &trans  &none   &none
            >;
        };

        Numerals {
            bindings = <
&trans  &none      &none   &none    &none   &none        &none   &none   &none   &none  &none  &trans
&trans  &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT     &none   &none   &none   &none  &none  &trans
&trans  &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL    &none   &none   &none   &none  &none  &trans
&trans  &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp FSLH     &none   &none   &none   &none  &none  &trans
                           &kp DOT  &kp N0  &kp MINUS    &trans  &trans  &trans
                           &none    &none   &none        &none   &trans  &none
            >;
        };

        Functions {
            bindings = <
&trans  &none    &none   &none   &none   &none     &none   &none   &none   &none  &none  &trans
&trans  &kp F12  &kp F7  &kp F8  &kp F9  &none     &none   &none   &none   &none  &none  &trans
&trans  &kp F11  &kp F4  &kp F5  &kp F6  &none     &none   &none   &none   &none  &none  &trans
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &none     &none   &none   &none   &none  &none  &trans
                         &trans  &trans  &trans    &trans  &trans  &trans
                         &none   &none   &none     &none   &none   &trans
            >;
        };
    };
};

// //right hand trackball overrides
// &trackball_peripheral_listener {
//     input-processors =
//         <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,//this gets it to the default installation orientation
//         <&zip_temp_layer 3 500>;//activate layer 3 within 500ms of the trackball moving
// };
// //left hand trackball overrides 
// &trackball_central_listener {
//     input-processors = 
//         <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,//this gets it to the default installation orientation
//         <&zip_xy_scaler 1 3>,//multiply sensitivity by 1, divide by 3 (make it slower for scrolling)
//         <&zip_xy_to_scroll_mapper>,//make this trackball output scrolling events by default instead of cursor movement
//         <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;//invert vertical scrolling so that the view moves in the same direction as the top of the trackball.
// };
